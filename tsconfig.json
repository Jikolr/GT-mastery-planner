{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "dom.iterable", "esnext"], "strict": true,
    "skipLibCheck": true, "noEmit": true, "esModuleInterop": true, "module": "esnext",
    "moduleResolution": "bundler", "resolveJsonModule": true, "isolatedModules": true,
    "jsx": "react-jsx", "types": ["node", "vite/client", "vite-plugin-pwa/client"]
  },
  "include": ["app", "desktop", "tests", "*.ts", "*.mts"],
  "exclude": ["node_modules", "dist", "desktop-dist", "release", "next-env.d.ts"]
}
